{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "spring-tools-mcp",
            "tool": "refreshWorkspace",
            "input": {}
          }
        ]
      }
    ]
  }
}
